{
  "name": "qa-trial-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "QA framework trial - Playwright automation and discovery harness for the JHipster sample app",
  "scripts": {
    "discover": "tsx discovery/explore.ts",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:db": "playwright test --project=db",
    "test:persistence": "playwright test --project=persistence",
    "test:ui": "playwright test --project=ui",
    "test:e2e": "playwright test --project=e2e",
    "test:headed": "playwright test --headed",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "report": "playwright show-report reports/html"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
