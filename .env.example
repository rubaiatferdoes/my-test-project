# Copy to .env and fill in. NEVER commit .env. Local trial environment only.

# ===== REQUIRED =====

# The sample app (JHipster), running locally
TEST_ENV_BASE_URL=http://localhost:8080
TEST_ENV_API_URL=http://localhost:8080/api
TEST_ENV_SWAGGER_URL=http://localhost:8080/v3/api-docs

# The two accounts the sample app ships with
QA_TENANT_A_USER=admin
QA_TENANT_A_PASSWORD=admin
QA_TENANT_B_USER=user
QA_TENANT_B_PASSWORD=user

# ===== DISCOVERY =====

# Hosts discovery may navigate to. Empty = only the host of
# TEST_ENV_BASE_URL, which is what we want here.
DISCOVERY_ALLOWED_HOSTS=

# Watch the walk happen (slower, useful the first time): true | false
DISCOVERY_HEADED=true

# Safety cap for the count/quota probe. Empty = 25.
DISCOVERY_QUOTA_PROBE_CAP=25

# ===== DATABASE =====
# none     = blind pass: step 8 is OUT, storage is checked by @persistence probes.
# readonly = the tracer pass. Run `none` FIRST, score it, then flip to `readonly`
#            and use the tracer as the answer key (CLAUDE.md section 13).
DB_ACCESS=none

# Read-only user - only used when DB_ACCESS=readonly
# We own this database, so SELECT access is set up at step 0.

DB_TYPE=postgres
DB_URL=localhost:5432/jhipsterSampleApplication
DB_READONLY_USER=qa_readonly
DB_READONLY_PASSWORD=
DB_SCHEMA=public

# ===== TRIAL ONLY =====
# Where the app's source sits, for scoring discovery AFTER approval
# (CLAUDE.md section 13). Agents must not read it during a step.
SAMPLE_APP_SOURCE=../sample-app
